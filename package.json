{
  "name": "wp-webmcp-agentops",
  "version": "0.1.0",
  "private": true,
  "description": "Development and browser-test tooling for Agent SNR, agent outcome monitoring for WordPress.",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "postinstall": "node bin/patch-webmcp-evals.mjs",
    "lint:js": "eslint plugin/wmcp-agentops/assets/js 'tests/**/*.{js,mjs}' 'demo/**/*.mjs' 'bin/**/*.mjs'",
    "lint:css": "stylelint 'plugin/wmcp-agentops/assets/css/**/*.css'",
    "test:js": "node --test tests/JavaScript/**/*.test.js tests/JavaScript/**/*.test.mjs",
    "test:showcase": "bash tests/Shell/showcase-launcher.test.sh",
    "test:browser": "playwright test",
    "test:render": "node --test tests/JavaScript/render-deployment.test.mjs",
    "test:webmcp:fixtures": "node --test tests/JavaScript/webmcp-evals.test.mjs",
    "test:webmcp:smoke": "node bin/run-webmcp-smoke.mjs",
    "generate:webmcp:schemas": "docker run --rm --volume \"$PWD:/app\" --workdir /app php:8.3-cli php bin/generate-webmcp-eval-schemas.php",
    "check:webmcp:schemas": "docker run --rm --volume \"$PWD:/app\" --workdir /app php:8.3-cli php bin/generate-webmcp-eval-schemas.php --check",
    "check:webmcp:report": "node bin/check-webmcp-eval-report.mjs",
    "test": "npm run test:js",
    "verify": "npm run lint:js && npm run lint:css && npm run test:showcase && npm run test:js",
    "build": "./bin/build-plugin.sh",
    "build:playground": "./bin/build-playground-bundle.sh",
    "showcase:capture": "node demo/showcase-capture.mjs"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "js-yaml": "5.4.1",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "webmcp-evals": "0.0.4"
  }
}
