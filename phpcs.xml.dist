<?xml version="1.0"?>
<ruleset name="WebMCP Agent Experience Monitor">
  <description>PSR-12 plus WordPress security/API rules and PHP 8.1 compatibility.</description>

  <file>plugin/wmcp-agentops</file>
  <file>tests</file>

  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/assets/*</exclude-pattern>

  <arg name="basepath" value="."/>
  <arg name="colors"/>
  <arg value="sp"/>
  <arg name="extensions" value="php"/>

  <config name="ignore_warnings_on_exit" value="1"/>

  <config name="minimum_supported_wp_version" value="6.9"/>
  <config name="testVersion" value="8.1-"/>

  <rule ref="PSR12">
    <exclude name="PSR1.Methods.CamelCapsMethodName"/>
    <exclude name="PSR1.Files.SideEffects.FoundWithSymbols"/>
    <exclude-pattern>plugin/wmcp-agentops/templates/*</exclude-pattern>
  </rule>
  <rule ref="Generic.Files.LineLength">
    <properties>
      <property name="lineLimit" value="160"/>
      <property name="absoluteLineLimit" value="0"/>
    </properties>
  </rule>
  <rule ref="PHPCompatibilityWP"/>

  <rule ref="WordPress.CodeAnalysis.EscapedNotTranslated">
    <exclude-pattern>tests/*</exclude-pattern>
  </rule>
  <rule ref="WordPress.DB.PreparedSQL">
    <exclude-pattern>tests/*</exclude-pattern>
  </rule>
  <rule ref="WordPress.DB.PreparedSQLPlaceholders">
    <exclude-pattern>tests/*</exclude-pattern>
  </rule>
  <rule ref="WordPress.DB.RestrictedClasses">
    <exclude-pattern>tests/*</exclude-pattern>
  </rule>
  <rule ref="WordPress.DB.RestrictedFunctions">
    <exclude-pattern>tests/*</exclude-pattern>
  </rule>
  <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
    <exclude-pattern>tests/*</exclude-pattern>
  </rule>
  <rule ref="WordPress.PHP.NoSilencedErrors"/>
  <rule ref="WordPress.PHP.RestrictedPHPFunctions"/>
  <rule ref="WordPress.PHP.StrictInArray"/>
  <rule ref="WordPress.Security.EscapeOutput">
    <exclude-pattern>tests/*</exclude-pattern>
  </rule>
  <rule ref="WordPress.Security.NonceVerification">
    <exclude-pattern>tests/*</exclude-pattern>
  </rule>
  <rule ref="WordPress.Security.SafeRedirect">
    <exclude-pattern>tests/*</exclude-pattern>
  </rule>
  <rule ref="WordPress.WP.Capabilities">
    <exclude-pattern>tests/*</exclude-pattern>
    <properties>
      <property name="custom_capabilities" type="array">
        <element value="manage_wmcp_tools"/>
        <element value="manage_wmcp_policies"/>
        <element value="view_wmcp_analytics"/>
        <element value="export_wmcp_analytics"/>
        <element value="view_wmcp_security_log"/>
        <element value="manage_wmcp_demo"/>
      </property>
    </properties>
  </rule>
  <rule ref="WordPress.WP.EnqueuedResources">
    <exclude-pattern>tests/*</exclude-pattern>
  </rule>
  <rule ref="WordPress.WP.I18n">
    <exclude-pattern>tests/*</exclude-pattern>
  </rule>
</ruleset>
