# Local Docker demo settings. Copy to .env and replace placeholders locally.
WMCP_HTTP_PORT=18080
WMCP_BIND_HOST=127.0.0.1
WMCP_WORDPRESS_IMAGE=wordpress:7.1-php8.3-apache
WMCP_CLI_IMAGE=wordpress:cli-2.12-php8.3
WMCP_WOOCOMMERCE_VERSION=11.0.1
WMCP_DB_NAME=wordpress
WMCP_DB_USER=wordpress
WMCP_DB_PASSWORD=replace-with-local-password
WMCP_DB_ROOT_PASSWORD=replace-with-local-root-password
WMCP_ADMIN_USER=wmcp-admin
WMCP_ADMIN_PASSWORD=replace-with-local-admin-password
WMCP_ADMIN_EMAIL=demo-admin@example.invalid
