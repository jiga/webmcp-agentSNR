  {
    "name": "Storefront smoke: search public products",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Find an in-stock waterproof backpack under $100 with IPX5 protection."
      }
    ],
    "expectedCall": [
      {
        "functionName": "search_products",
        "arguments": {
          "query": "waterproof backpack",
          "max_price": 100,
          "attributes": {
            "water_rating": "IPX5"
          },
          "in_stock_only": true,
          "limit": 6
        }
      }
