[
  {
    "name": "Live shopper: recover constraints and prepare human checkout",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Start with this site's Agent Guide. Find an in-stock waterproof backpack under $100 with at least IPX5 protection. Wait for that search result before deciding whether to relax the constraint; never issue the IPX5 and IPX4 searches in parallel. If none match, continue without pausing: relax only the water rating to IPX4 and search again. Compare the two best matches, verify the returns policy, read the current cart, add the compact option, and prepare checkout. The comparison, policy, and cart reads may occur in any order after the relaxed search. Stop at the handoff: do not navigate, place an order, accept terms, submit customer data, or process payment. Do not submit feedback before the checkout handoff. After the handoff, you may submit at most one bounded evidence-linked report describing the IPX5-to-IPX4 trade-off as a partial constraint encountered during the journey summary."
      }
    ],
    "expectedCall": [
      {
        "functionName": "get_agent_guide",
        "arguments": {},
        "result": {
          "ok": true
        }
      },
      {
        "functionName": "search_products",
        "arguments": {
          "query": {
            "$pattern": "(?i)backpack"
          },
          "max_price": {
            "$lte": 100
          },
          "attributes": {
            "water_rating": "IPX5"
          },
          "in_stock_only": true
        },
        "result": {
          "ok": true
        }
      },
      {
        "functionName": "search_products",
        "arguments": {
          "query": {
            "$pattern": "(?i)backpack"
          },
          "max_price": {
