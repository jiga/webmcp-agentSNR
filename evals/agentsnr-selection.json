          "reason": {
            "$contains": "rehearsal"
          }
        }
      }
    ]
  },
  {
    "name": "Recovery: diagnose after a session tool change",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "I disabled compare_products for this session."
      },
      {
        "role": "model",
        "type": "functioncall",
        "name": "set_tool_enabled",
        "arguments": {
          "tool_name": "compare_products",
          "enabled": false,
          "scope": "demo_session",
          "reason": "Exercise fallback behavior"
        }
      },
      {
        "role": "user",
        "type": "functionresponse",
        "name": "set_tool_enabled",
        "response": {
          "result": {
            "tool_name": "compare_products",
            "requested_enabled": false,
            "scope": "demo_session",
            "effective_revision": "rev_0123456789abcdef01234567"
          }
        }
      },
      {
        "role": "user",
        "type": "message",
        "content": "Now run the safe manifest and session checks so I can verify the refreshed state."
      }
    ],
    "expectedCall": [
      {
        "functionName": "run_webmcp_diagnostics",
        "arguments": {
          "checks": [
            "manifest",
            "session"
          ]
        }
      }
    ]
  },
